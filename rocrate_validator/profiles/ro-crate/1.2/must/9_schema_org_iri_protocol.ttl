@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.2/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ro-crate:SchemaOrgTypeProtocol a sh:NodeShape ;
    sh:name "Schema.org @type protocol" ;
    sh:description "Schema.org @type values MUST use the http://schema.org/ namespace defined by the RO-Crate context." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes ro-crate:sparqlPrefixes ;
        sh:select """
            SELECT DISTINCT ?this
            WHERE {
                ?this a ?schemaType .
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ro-crate:sparqlPrefixes ;
        sh:select """
            SELECT $this ?schemaType ?term ?httpType
            WHERE {
                $this a ?schemaType .
                FILTER(STRSTARTS(STR(?schemaType), "https://schema.org/"))
                BIND(SUBSTR(STR(?schemaType), STRLEN("https://schema.org/") + 1) AS ?term)
                BIND(IRI(CONCAT("http://schema.org/", ?term)) AS ?httpType)
            }
        """ ;
        sh:message "Entity {?this} declares the @type '{?schemaType}', which is not a term of the RO-Crate @context: the context maps Schema.org terms to 'http://schema.org/', so the entity MUST be typed '{?term}' (i.e. '{?httpType}')" ;
        sh:severity sh:Violation
    ] .
