@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate-1.2/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ro-crate:SchemaOrgIdCompatibility a sh:NodeShape ;
    sh:name "Schema.org @id compatibility" ;
    sh:description "Nested Schema.org @id references SHOULD use the http://schema.org/ namespace for compatibility with the RO-Crate context." ;
    # OWL-RL adds reflexive owl:sameAs triples for IRIs; these are not nested
    # @id references and must not produce compatibility recommendations.
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes ro-crate:sparqlPrefixes ;
        sh:select """
            SELECT DISTINCT ?this
            WHERE {
                ?this ?predicate ?schemaId .
                FILTER(?predicate NOT IN (
                    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>,
                    <http://www.w3.org/2002/07/owl#sameAs>
                ))
                FILTER(isIRI(?schemaId))
                FILTER(STRSTARTS(STR(?schemaId), "https://schema.org/"))
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ro-crate:sparqlPrefixes ;
        sh:select """
            SELECT $this ?predicate ?schemaId ?term ?httpId
            WHERE {
                $this ?predicate ?schemaId .
                FILTER(?predicate NOT IN (
                    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>,
                    <http://www.w3.org/2002/07/owl#sameAs>
                ))
                FILTER(isIRI(?schemaId))
                FILTER(STRSTARTS(STR(?schemaId), "https://schema.org/"))
                BIND(SUBSTR(STR(?schemaId), STRLEN("https://schema.org/") + 1) AS ?term)
                BIND(IRI(CONCAT("http://schema.org/", ?term)) AS ?httpId)
            }
        """ ;
        sh:message "Entity {?this} references the Schema.org IRI '{?schemaId}' through a nested @id. For compatibility with the RO-Crate @context, the reference SHOULD use '{?term}' (i.e. '{?httpId}')" ;
        sh:severity sh:Warning
    ] .
