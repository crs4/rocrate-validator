@prefix workflow-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/workflow-ro-crate/1.1/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

workflow-ro-crate:WROCHowToStepOptional a sh:NodeShape ;
    sh:name "WROC HowToStep MAY" ;
    sh:description "Optional properties of a Workflow RO-Crate HowToStep" ;
    sh:targetClass schema:HowToStep ;
    sh:property [
        a sh:PropertyShape ;
        sh:name "HowToStep position" ;
        sh:description "A HowToStep may indicate its position in the execution order via position" ;
        sh:path schema:position ;
        sh:minCount 1 ;
        sh:message "A HowToStep may indicate its position in the execution order via position" ;
    ] .
