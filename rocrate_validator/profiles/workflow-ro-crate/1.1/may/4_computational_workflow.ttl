@prefix schema: <http://schema.org/> .
@prefix bioschemas: <https://bioschemas.org/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix workflow-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/workflow-ro-crate/1.1/> .

workflow-ro-crate:WROCComputationalWorkflowOptional a sh:NodeShape ;
    sh:name "Workflow RO-Crate ComputationalWorkflow MAY" ;
    sh:description "Optional properties of a Workflow RO-Crate ComputationalWorkflow" ;
    sh:targetClass bioschemas:ComputationalWorkflow ;
    sh:property [
        a sh:PropertyShape ;
        sh:name "ComputationalWorkflow input" ;
        sh:description "A ComputationalWorkflow MAY have an input" ;
        sh:path bioschemas:input ;
        sh:minCount 1 ;
        sh:message "A ComputationalWorkflow MAY have an input" ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:name "ComputationalWorkflow output" ;
        sh:description "A ComputationalWorkflow MAY have an output" ;
        sh:path bioschemas:output ;
        sh:minCount 1 ;
        sh:message "A ComputationalWorkflow MAY have an output" ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:name "ComputationalWorkflow step" ;
        sh:description "A ComputationalWorkflow MAY have a step property" ;
        sh:path schema:step ;
        sh:minCount 1 ;
        sh:message "A ComputationalWorkflow MAY have a step property" ;
    ] .
