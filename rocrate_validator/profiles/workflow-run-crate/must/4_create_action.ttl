@prefix ro: <./> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate/> .
@prefix schema: <http://schema.org/> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-cw: <https://bioschemas.org/ComputationalWorkflow#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix workflow-run-crate: <https://github.com/crs4/rocrate-validator/profiles/workflow-run-crate/> .


workflow-run-crate:CreateActionWithMainEntityAsInstrumentRequired a sh:NodeShape ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:property [
        sh:name "Main entity execution" ;
        sh:path (
            schema:mainEntity
            [ sh:inversePath schema:instrument ]
        ) ;
        sh:qualifiedValueShape [
            sh:class schema:CreateAction ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one CreateAction MUST reference the root data entity's mainEntity as its instrument." ;
    ] .
